POSTGRES_PASSWORD=change-me
POSTGRES_DB=contributions

# Long random string, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
